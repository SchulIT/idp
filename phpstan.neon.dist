parameters:
	level: 5
	customRulesetUsed: true
	paths:
	    - src
	inferPrivatePropertyTypeFromConstructor: true
	symfony:
		containerXmlPath: '%rootDir%/../../../var/cache/dev/App_KernelDevDebugContainer.xml'
	doctrine:
		objectManagerLoader: tests/object-manager.php
		allowNullablePropertyForRequiredField: true
	ignoreErrors:
		-
		    rawMessage: 'Property App\Entity\OAuthClient::$identifier type mapping mismatch: database can contain string but property expects non-empty-string.'
		    path: src/Entity/OAuthClient.php
