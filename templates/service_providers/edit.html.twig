{% extends "main.html.twig" %}

{% block title %}{{ 'service_providers.edit.label'|trans }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dashboard') }}">{{ 'dashboard.label'|trans }}</a></li>
        <li class="breadcrumb-item"><a href="{{ path('service_providers') }}">{{ 'service_providers.label'|trans }}</a></li>
        <li class="breadcrumb-item">{{ service_provider.name }}</li>
        <li class="breadcrumb-item">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block post_javascript %}
    <script src="{{ asset('js/collection.js') }}"></script>
{% endblock %}

{% block content %}
    {{ form_start(form) }}

    <div class="card">
        <div class="card-header">{{ 'label.general'|trans }}</div>

        <div class="card-body">
            {% for child in form %}
                {% if child.vars.name != "acsUrls" and child.vars.name != "attributeNameMapping" and child.vars.name != "client" %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}

            {% if form.attributeNameMapping is defined %}
            <div class="mb-3 row">
                {{ form_label(form.attributeNameMapping) }}

                <div class="col-sm-10">
                    <div class="mapping" data-collection="mapping" data-prototype="{{ form_widget(form.attributeNameMapping.vars.prototype)|e("html_attr") }}">
                        {% for item in form.attributeNameMapping %}
                            {{ form_widget(item) }}
                        {% endfor %}
                    </div>

                    {{ form_errors(form.attributeNameMapping) }}
                    {{ form_help(form.attributeNameMapping) }}

                    <button class="btn btn-outline-primary btn-sm btn-add" type="button" data-collection="mapping">
                        <i class="fa fa-plus"></i> {{ 'actions.add'|trans }}
                    </button>

                    {% do form.attributeNameMapping.setRendered %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {% if form.acsUrls is defined %}
    <div class="card">
        <div class="card-header">{{ 'label.acs'|trans }}</div>
        <div class="card-body">
            <div class="acs" data-collection="acs" data-prototype="{{ form_widget(form.acsUrls.vars.prototype)|e('html_attr') }}">
                {% for child in form.acsUrls %}
                    {{ form_widget(child) }}
                {% endfor %}

                {{ form_help(form.acsUrls) }}
                {{ form_errors(form.acsUrls) }}
                {% do form.acsUrls.setRendered %}
            </div>
        </div>
        <div class="card-footer">
            <button class="btn btn-outline-primary btn-sm btn-add" type="button" data-collection="acs">
                <i class="fa fa-plus"></i> {{ 'actions.add'|trans }}
            </button>
        </div>
    </div>
    {% endif %}

    {% if form.client is defined %}
        <div class="card">
            <div class="card-header">{{ 'service_providers.oidc.header'|trans }}</div>
            <div class="card-body">
                {{ form_row(form.client.identifier) }}
                {{ form_row(form.client.scopeName) }}

                <div class="mb-3 row">
                    {{ form_label(form.client.redirectUris) }}

                    <div class="col-sm-10">
                        <div class="acs" data-collection="redirect-uris" data-prototype="{{ form_widget(form.client.redirectUris.vars.prototype)|e('html_attr') }}">
                            {% for child in form.client.redirectUris %}
                                {{ form_widget(child) }}
                            {% endfor %}
                        </div>

                        {{ form_help(form.client.redirectUris) }}
                        {{ form_errors(form.client.redirectUris) }}
                        {% do form.client.redirectUris.setRendered %}
                    </div>
                </div>
            </div>

            <div class="card-footer">
                <button class="btn btn-outline-primary btn-sm btn-add" type="button" data-collection="redirect-uris">
                    <i class="fa fa-plus"></i> {{ 'actions.add'|trans }}
                </button>
            </div>
        </div>
    {% endif %}

    <div class="buttons">
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="fas fa-save"></i> {{ 'actions.save'|trans }}
        </button>

        <a href="{{ path('service_providers') }}" class="btn btn-sm btn-secondary">
            {{ 'actions.cancel'|trans }}
        </a>
    </div>
    {{ form_end(form) }}


{% endblock %}